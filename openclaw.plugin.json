{
  "id": "google-antigravity-cli",
  "name": "Google Antigravity CLI",
  "description": "Run Google Antigravity as a native OpenClaw CLI model backend",
  "cliBackends": [
    "google-antigravity-cli"
  ],
  "modelCatalog": {
    "providers": {
      "google-antigravity-cli": {
        "models": []
      }
    },
    "discovery": {
      "google-antigravity-cli": "refreshable"
    }
  },
  "syntheticAuthRefs": [
    "google-antigravity-cli"
  ],
  "setup": {
    "cliBackends": [
      "google-antigravity-cli"
    ],
    "requiresRuntime": false
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "providers": [
    "google-antigravity-cli"
  ],
  "providerCatalogEntry": "./dist/provider-discovery.js",
  "nonSecretAuthMarkers": [
    "antigravity-local-session"
  ]
}
